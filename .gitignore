# Ignore files created by Home Assistant
.cloud
.storage
deps
ssl
sql
external

# Ignore files created by Python
.venv
__pycache__/
*.pyc
*.pyo
*.pyd

# Specific file ignores
core
image
ip_bans.yaml
secrets.yaml
secrets.yml
.HA_VERSION
*_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]

# Ignore files created by IDE's
.vscode/
.devcontainer*
.theia/
.Trash*

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
.cache/
known_hosts
nohup.out
$RECYCLE.BIN/
[Dd]esktop.ini
*~

# Ignore compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so
*.rpm

# Ignore packages
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.tar.gz
*.tgz
*.zip

# Ignore Logs and databases
*.log*
*.sql
*.sqlite
*.db*